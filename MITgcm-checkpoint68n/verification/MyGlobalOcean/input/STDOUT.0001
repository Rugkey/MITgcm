(PID.TID 0001.0001)  DIAGNOSTICS_READPARMS: opening data.diagnostics
(PID.TID 0001.0001)  OPEN_COPY_DATA_FILE: opening file data.diagnostics
(PID.TID 0001.0001) // =======================================================
(PID.TID 0001.0001) // Parameter file "data.diagnostics"
(PID.TID 0001.0001) // =======================================================
(PID.TID 0001.0001) ># Diagnostic Package Choices
(PID.TID 0001.0001) >#--------------------
(PID.TID 0001.0001) >#  dumpAtLast (logical): always write output at the end of simulation (default=F)
(PID.TID 0001.0001) >#  diag_mnc   (logical): write to NetCDF files (default=useMNC)
(PID.TID 0001.0001) >#--for each output-stream:
(PID.TID 0001.0001) >#  fileName(n) : prefix of the output file name (max 80c long) for outp.stream n
(PID.TID 0001.0001) >#  frequency(n):< 0 : write snap-shot output every |frequency| seconds
(PID.TID 0001.0001) >#               > 0 : write time-average output every frequency seconds
(PID.TID 0001.0001) >#  timePhase(n)     : write at time = timePhase + multiple of |frequency|
(PID.TID 0001.0001) >#    averagingFreq  : frequency (in s) for periodic averaging interval
(PID.TID 0001.0001) >#    averagingPhase : phase     (in s) for periodic averaging interval
(PID.TID 0001.0001) >#    repeatCycle    : number of averaging intervals in 1 cycle
(PID.TID 0001.0001) >#  levels(:,n) : list of levels to write to file (Notes: declared as REAL)
(PID.TID 0001.0001) >#                when this entry is missing, select all common levels of this list
(PID.TID 0001.0001) >#  fields(:,n) : list of selected diagnostics fields (8.c) in outp.stream n
(PID.TID 0001.0001) >#                (see "available_diagnostics.log" file for the full list of diags)
(PID.TID 0001.0001) >#  missing_value(n) : missing value for real-type fields in output file "n"
(PID.TID 0001.0001) >#  fileFlags(n)     : specific code (8c string) for output file "n"
(PID.TID 0001.0001) >#--------------------
(PID.TID 0001.0001) ># This example dumps snapshot of all KPP diagnostics every day,
(PID.TID 0001.0001) >#  at mid day (t=12.h, baseTime=6.h, deltaT=1.h => iter=6)
(PID.TID 0001.0001) > &DIAGNOSTICS_LIST
(PID.TID 0001.0001) >  fields(1:1,1)  = 'ETAN    ',
(PID.TID 0001.0001) >   fileName(1) = 'output/surf',
(PID.TID 0001.0001) >  frequency(1) = -86400.,
(PID.TID 0001.0001) >  fields(1:4,2)  = 'UVEL    ','VVEL    ','THETA   ','SALT    ',
(PID.TID 0001.0001) >   fileName(2) = 'output/state',
(PID.TID 0001.0001) >  frequency(2) = -86400.,
(PID.TID 0001.0001) > /
(PID.TID 0001.0001) >
(PID.TID 0001.0001) >#--------------------
(PID.TID 0001.0001) ># Parameter for Diagnostics of per level statistics:
(PID.TID 0001.0001) >#--------------------
(PID.TID 0001.0001) >#  diagSt_mnc (logical): write stat-diags to NetCDF files (default=diag_mnc)
(PID.TID 0001.0001) >#  diagSt_regMaskFile : file containing the region-mask to read-in
(PID.TID 0001.0001) >#  nSetRegMskFile   : number of region-mask sets within the region-mask file
(PID.TID 0001.0001) >#  set_regMask(i)   : region-mask set-index that identifies the region "i"
(PID.TID 0001.0001) >#  val_regMask(i)   : region "i" identifier value in the region mask
(PID.TID 0001.0001) >#--for each output-stream:
(PID.TID 0001.0001) >#  stat_fName(n) : prefix of the output file name (max 80c long) for outp.stream n
(PID.TID 0001.0001) >#  stat_freq(n):< 0 : write snap-shot output every |stat_freq| seconds
(PID.TID 0001.0001) >#               > 0 : write time-average output every stat_freq seconds
(PID.TID 0001.0001) >#  stat_phase(n)    : write at time = stat_phase + multiple of |stat_freq|
(PID.TID 0001.0001) >#  stat_region(:,n) : list of "regions" (default: 1 region only=global)
(PID.TID 0001.0001) >#  stat_fields(:,n) : list of selected diagnostics fields (8.c) in outp.stream n
(PID.TID 0001.0001) >#                (see "available_diagnostics.log" file for the full list of diags)
(PID.TID 0001.0001) >#--------------------
(PID.TID 0001.0001) > &DIAG_STATIS_PARMS
(PID.TID 0001.0001) >#- an example just to check the agreement with MONITOR output:
(PID.TID 0001.0001) >#stat_fields(1:5,1)  = 'ETAN    ','UVEL    ','VVEL    ','WVEL    ', 'THETA   ',
(PID.TID 0001.0001) ># stat_fName(1) = 'dynStDiag',
(PID.TID 0001.0001) >#  stat_freq(1) = -864000.,
(PID.TID 0001.0001) ># stat_phase(1) = 0.,
(PID.TID 0001.0001) > /
(PID.TID 0001.0001) >
