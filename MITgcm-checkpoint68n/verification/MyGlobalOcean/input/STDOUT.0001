(PID.TID 0001.0001) // Parameter file "data.gmredi"
(PID.TID 0001.0001) // =======================================================
(PID.TID 0001.0001) ># GM+Redi package parameters:
(PID.TID 0001.0001) >
(PID.TID 0001.0001) >#-from MOM :
(PID.TID 0001.0001) ># GM_background_K: 	G & Mc.W  diffusion coefficient
(PID.TID 0001.0001) ># GM_maxSlope    :	max slope of isopycnals
(PID.TID 0001.0001) ># GM_Scrit       :	transition for scaling diffusion coefficient
(PID.TID 0001.0001) ># GM_Sd          :	half width scaling for diffusion coefficient
(PID.TID 0001.0001) ># GM_taper_scheme:	slope clipping or one of the tapering schemes
(PID.TID 0001.0001) ># GM_Kmin_horiz  :	horizontal diffusion minimum value
(PID.TID 0001.0001) >
(PID.TID 0001.0001) >#-Option parameters (needs to "define" options in GMREDI_OPTIONS.h")
(PID.TID 0001.0001) ># GM_isopycK     :	isopycnal diffusion coefficient (default=GM_background_K)
(PID.TID 0001.0001) ># GM_AdvForm     :	turn on GM Advective form       (default=Skew flux form)
(PID.TID 0001.0001) >
(PID.TID 0001.0001) > &GM_PARM01
(PID.TID 0001.0001) >  GM_background_K    = 1.e+3,
(PID.TID 0001.0001) >  GM_taper_scheme    = 'gkw91',
(PID.TID 0001.0001) >  GM_maxSlope        = 1.e-2,
(PID.TID 0001.0001) >  GM_Kmin_horiz      = 50.,
(PID.TID 0001.0001) >  GM_Scrit           = 4.e-3,
(PID.TID 0001.0001) >  GM_Sd              = 1.e-3,
(PID.TID 0001.0001) ># GM_Visbeck_alpha   = 0.,
(PID.TID 0001.0001) ># GM_Visbeck_length  = 2.e+5,
(PID.TID 0001.0001) ># GM_Visbeck_depth   = 1.e+3,
(PID.TID 0001.0001) ># GM_Visbeck_maxval_K= 2.5e+3,
(PID.TID 0001.0001) > /
(PID.TID 0001.0001) >
(PID.TID 0001.0001) >
