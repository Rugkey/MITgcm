# Pollutant Package Parameters - Using Unified Degradation Model

 &POLLUTANT_PARAMS

# --- Forcing Parameters ---
  pollutant_emission_file   = 'pollutant_emission.bin',
  pollutant_forcingPeriod   = 900.,
  pollutant_forcingCycle    = 900.,
# if mol/s:.TRUE. . if mol/m2/s use .FALSE.
  pollutant_fluxIsCellTotal = .TRUE.,

  usePollutantDegradation = .TRUE.,
  pollutant_Tc            = 4.0,

  pollutant_k_dark_20_d   = 0.01,
  pollutant_Q10_dark      = 2.0,

  pollutant_k_bio_20_d    = 0.005,
  pollutant_Q10_bio       = 2.2,

  pollutant_k_OH_d        = 0.001,

  pollutant_k_photo_d     = 0.1,
  pollutant_light_atten   = 0.15,

# airseaexchange mode
  usePollutantAirSeaExchange = .TRUE.,
  pollutant_useDryDeposition = .TRUE.,
  pollutant_useWetDeposition = .TRUE.,

  pollutant_henryConst = 2.5,
  pollutant_schmidtRef = 660.,
  pollutant_schmidtExp = 0.5,
  pollutant_schmidtA0  = 660.,
  pollutant_schmidtA1  = 0.0,
  pollutant_schmidtA2  = 0.0,
  pollutant_schmidtA3  = 0.0,
  pollutant_pistonCoeff = 0.31,
  pollutant_minWind     = 0.5,
  pollutant_defaultWind = 5.0,

  pollutant_atmConcConst = 1.0e-8,
  pollutant_dryDepVelConst = 1.0e-3,
  pollutant_wetDepConcConst = 1.0e-8,
# if use EXF, it won't work. it stands for rainfall speed.
  pollutant_precipConst = 3.0e-8,

  pollutant_atmConc_file    = ' ',
  pollutant_dryDepVel_file  = ' ',
  pollutant_wetDepConc_file = ' ',

 &